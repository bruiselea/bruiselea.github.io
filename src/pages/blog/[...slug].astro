---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props { post: CollectionEntry<"blog"> }
const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} — Blog`} description={post.data.description}>
  <main class="page-shell article-page">
    <article>
      <header class="article-header">
        <p class="eyebrow">BUILD NOTE</p>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <div>
          <time datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString("ja-JP")}</time>
          <span>{post.data.tags.join(" / ")}</span>
        </div>
      </header>
      <div class="article-prose">
        <Content />
      </div>
      <a class="text-link" href="/blog/">← ブログ一覧へ</a>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .article-page article { max-width: 900px; margin: 0 auto; }
  .article-header { padding-bottom: clamp(3rem, 7vw, 6rem); border-bottom: 1px solid var(--line); }
  .article-header h1 { max-width: 16ch; margin: 0; font-size: clamp(2.8rem, 7vw, 6.8rem); font-weight: 500; letter-spacing: -.055em; line-height: 1; }
  .article-header > p:not(.eyebrow) { max-width: 42rem; margin: 2rem 0; color: #b5b5bc; font-size: 1.05rem; line-height: 1.9; }
  .article-header > div { display: flex; gap: 2rem; color: var(--muted); font-family: var(--mono); font-size: .68rem; }
  .article-prose { max-width: 720px; padding: clamp(3rem, 7vw, 6rem) 0; }
  .article-prose :global(p) { margin: 0 0 1.8rem; color: #c2c2c7; font-size: 1.02rem; line-height: 2.05; }
  .article-prose :global(h2) { margin: 4rem 0 1.2rem; font-size: 2rem; font-weight: 540; }
  .article-prose :global(strong) { color: var(--ink); }
  .article-page .text-link { margin-bottom: 3rem; }
</style>
