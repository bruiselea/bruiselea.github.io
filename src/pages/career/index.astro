---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import { works } from "../../data/works";

const selectedWorks = [works[0], works[1], works[3]];
---

<BaseLayout
  title="Career — Natsuki Sato"
  description="佐藤夏樹の就活・採用向けプロフィール。材料工学、HCI、3Dモデリング、電子工作、ソフトウェアの経験をまとめています。"
>
  <main class="page-shell career-page">
    <header class="page-hero">
      <div>
        <p class="eyebrow">CAREER / PROFILE</p>
        <h1 class="page-title">Engineer who makes interactions tangible.</h1>
      </div>
      <p class="page-lede">
        材料工学を土台に、物理的なプロトタイプとソフトウェアを往復して制作しています。3Dモデリング、電子工作、UI実装をつなぎ、人が触れて理解できる形まで作ることが得意です。
      </p>
    </header>

    <section class="section-block career-summary">
      <div class="section-heading">
        <p class="meta-label">01 / POSITIONING</p>
        <h2>材料から、入力体験まで。</h2>
      </div>
      <div class="career-summary__grid">
        <p>
          東北大学工学部で材料科学を学び、デンマーク工科大学（DTU）への交換留学を経験しました。研究で身につけた観察・評価の視点を、3Dプリンティング、プロダクト、HCIの設計に応用しています。
        </p>
        <dl>
          <div><dt>FOCUS</dt><dd>HCI / Product / Modeling</dd></div>
          <div><dt>BUILD</dt><dd>PCB / 3D Print / Web</dd></div>
          <div><dt>LOCATION</dt><dd>Japan</dd></div>
          <div><dt>LANGUAGE</dt><dd>Japanese / English</dd></div>
        </dl>
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <p class="meta-label">02 / SELECTED WORK</p>
        <h2>短時間で見てほしい3件。</h2>
      </div>
      <div class="career-work-list">
        {selectedWorks.map((work) => (
          <a href={`/works/${work.slug}/`} style={`--work-accent:${work.accent}`}>
            <span>{work.index}</span>
            <div>
              <h3>{work.title}</h3>
              <p>{work.summary}</p>
            </div>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section-block career-capabilities">
      <div class="section-heading">
        <p class="meta-label">03 / CAPABILITIES</p>
        <h2>横断して、最後まで形にする。</h2>
      </div>
      <div class="career-capabilities__grid">
        <article>
          <p class="eyebrow">PHYSICAL</p>
          <h3>Modeling & Fabrication</h3>
          <p>CAD、3Dプリント、試作、材料と製造条件の検討。</p>
        </article>
        <article>
          <p class="eyebrow">ELECTRONICS</p>
          <h3>Hardware Prototyping</h3>
          <p>PCB設計、組み立て、組み込み、センサーと動きの検証。</p>
        </article>
        <article>
          <p class="eyebrow">DIGITAL</p>
          <h3>Interface Development</h3>
          <p>Webアプリ、Chrome拡張、UI設計、インタラクション実装。</p>
        </article>
      </div>
    </section>

    <section class="career-contact">
      <p class="eyebrow">CONTACT</p>
      <h2>制作、研究、プロトタイプの相談。</h2>
      <a class="primary-link" href="mailto:wlknts28786@gmail.com">メールで連絡する →</a>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .career-summary__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(3rem, 8vw, 8rem);
  }
  .career-summary__grid > p {
    margin: 0;
    color: #c0c0c6;
    font-size: clamp(1.05rem, 2vw, 1.5rem);
    line-height: 1.9;
  }
  dl { margin: 0; }
  dl div {
    display: grid;
    grid-template-columns: 0.55fr 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }
  dt { color: var(--accent); font-family: var(--mono); font-size: .65rem; letter-spacing: .12em; }
  dd { margin: 0; color: var(--muted); font-size: .85rem; }
  .career-work-list { border-top: 1px solid var(--line); }
  .career-work-list a {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .career-work-list a:hover h3 { color: var(--work-accent); }
  .career-work-list span { color: var(--work-accent); font-family: var(--mono); }
  .career-work-list h3 { margin: 0; font-size: clamp(1.3rem, 2.5vw, 2.2rem); font-weight: 520; line-break: strict; word-break: keep-all; }
  .career-work-list p { margin: .45rem 0 0; color: var(--muted); }
  .career-capabilities__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); }
  .career-capabilities article { min-height: 260px; padding: 2rem; background: var(--surface); }
  .career-capabilities h3 { margin: 0 0 2rem; font-size: 1.55rem; font-weight: 520; }
  .career-capabilities article > p:last-child { color: var(--muted); line-height: 1.8; }
  .career-contact { padding: clamp(4rem, 10vw, 9rem) 0; text-align: center; }
  .career-contact h2 { max-width: 18ch; margin: 0 auto 2.5rem; font-size: clamp(2.3rem, 5vw, 5rem); font-weight: 500; letter-spacing: -.04em; line-break: strict; word-break: keep-all; overflow-wrap: anywhere; }
  @media (max-width: 760px) {
    .career-summary__grid, .career-capabilities__grid { grid-template-columns: 1fr; }
    .career-work-list a { grid-template-columns: 38px 1fr auto; gap: .7rem; }
    .career-work-list p { display: none; }
  }
</style>
