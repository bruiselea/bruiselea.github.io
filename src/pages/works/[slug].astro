---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import WorkVisual from "../../components/WorkVisual.astro";
import { works, type Work } from "../../data/works";

export function getStaticPaths() {
  return works
    .filter((work) => !["10000-hours", "hondana-scan", "hand-spinner"].includes(work.slug))
    .map((work) => ({ params: { slug: work.slug }, props: { work } }));
}

interface Props { work: Work }
const { work } = Astro.props;
---

<BaseLayout title={`${work.title} — Natsuki Sato`} description={work.summary}>
  <main class="page-shell work-detail" style={`--work-accent:${work.accent}`}>
    <header class="work-detail__header">
      <div>
        <p class="eyebrow">{work.index} / {work.categoryLabel}</p>
        <h1>{work.title}</h1>
        <p class="work-detail__en">{work.titleEn}</p>
      </div>
      <p>{work.summary}</p>
    </header>

    <WorkVisual work={work} eager />

    <section class="work-detail__story">
      <div>
        <p class="meta-label">OVERVIEW</p>
        <h2>物体と体験を、同じ設計対象として扱う。</h2>
      </div>
      <div>
        <p>{work.description}</p>
        <dl>
          <div><dt>ROLE</dt><dd>{work.role.join(" / ")}</dd></div>
          <div><dt>TOOLS</dt><dd>{work.tools.join(" / ")}</dd></div>
          <div><dt>ASSET</dt><dd>{work.asset.caption ?? "Temporary render → own 3D model"}</dd></div>
        </dl>
        {work.externalUrl && <a class="primary-link" href={work.externalUrl} target="_blank" rel="noreferrer">公開版を開く ↗</a>}
      </div>
    </section>

    <section class="work-detail__next">
      <p class="eyebrow">CASE STUDY STATUS</p>
      <h2>写真・図面・試作ログを追加予定。</h2>
      <p>次の更新では、完成物だけでなく、判断の過程がわかる画像と検証内容を追加します。</p>
      <a class="text-link" href="/works/">← すべての作品へ</a>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .work-detail__header { display: grid; grid-template-columns: 1.25fr .75fr; gap: 4rem; align-items: end; padding-bottom: clamp(3rem, 7vw, 6rem); }
  .work-detail__header h1 { max-width: 12ch; margin: 0; font-size: clamp(3.2rem, 8vw, 7rem); font-weight: 500; letter-spacing: -.055em; line-height: .92; }
  .work-detail__header > p { margin: 0; color: #b4b4bb; font-size: 1.1rem; line-height: 1.9; }
  .work-detail__en { color: var(--muted); font-family: var(--mono); font-size: .72rem; letter-spacing: .12em; }
  .work-detail :global(.work-visual) { border: 1px solid var(--line); }
  .work-detail__story { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(3rem, 10vw, 10rem); padding: clamp(4rem, 9vw, 8rem) 0; border-bottom: 1px solid var(--line); }
  .work-detail__story h2 { max-width: 14ch; margin: 1rem 0 0; font-size: clamp(2rem, 4vw, 4rem); font-weight: 500; letter-spacing: -.04em; }
  .work-detail__story > div:last-child > p { margin: 0 0 3rem; color: #b8b8bf; font-size: 1.05rem; line-height: 2; }
  dl { margin: 0 0 3rem; }
  dl div { display: grid; grid-template-columns: 100px 1fr; gap: 1rem; padding: 1rem 0; border-top: 1px solid var(--line); }
  dt { color: var(--work-accent); font-family: var(--mono); font-size: .66rem; }
  dd { margin: 0; color: var(--muted); font-size: .78rem; line-height: 1.6; }
  .work-detail__next { max-width: 820px; padding: clamp(4rem, 9vw, 8rem) 0; }
  .work-detail__next h2 { margin: 0 0 1rem; font-size: clamp(2.2rem, 5vw, 4.8rem); font-weight: 500; letter-spacing: -.04em; }
  .work-detail__next > p:not(.eyebrow) { color: var(--muted); line-height: 1.8; }
  .work-detail__next .text-link { margin-top: 2rem; }
  @media (max-width: 760px) { .work-detail__header, .work-detail__story { grid-template-columns: 1fr; gap: 2rem; } }
</style>
