---
import HandSpinnerLayout from "../../../layouts/HandSpinnerLayout.astro";
const base = "/works/hand-spinner/";
const skins = [
  { name: "Atomic Purple", file: "atomic-purple.png" },
  { name: "Glacier Blue", file: "glacier-blue.png" },
  { name: "Smoke", file: "smoke.png" },
  { name: "Tangerine", file: "tangerine.png" },
];
---

<HandSpinnerLayout title="Hand Spinner — A tiny toy for your Mac | nuunnu.com" description="Hold Space. Move one finger. Let it fly. A pixel-art desktop fidget toy for your Mac, with real momentum and four translucent skins.">
  <section class="hero">
    <div>
      <p class="eyebrow">A TINY TOY FOR YOUR MAC</p>
      <h1>SPIN.<br />FOCUS.<br /><span>REPEAT.</span></h1>
      <p class="hero-lede">Hold Space. Move one finger. Let it fly.</p>
      <p class="muted">A tactile desktop fidget toy built for your trackpad.</p>
      <div class="hero-actions">
        <a class="primary-link" href={`${base}support/`}>HOW TO PLAY ↗</a>
        <span class="availability">Coming soon to the Mac App Store</span>
      </div>
    </div>
    <div class="hero-visual">
      <img src={`${base}app-icon.png`} alt="Hand Spinner app icon: a black and silver pixel-art spinner with an orange trail" width="1254" height="1254" fetchpriority="high" />
      <p>macOS 14+ <span>·</span> Apple silicon &amp; Intel</p>
    </div>
  </section>

  <section class="play section-block" aria-labelledby="play-title">
    <div class="play-copy">
      <p class="eyebrow">01 / JUST ONE MORE SPIN</p>
      <h2 id="play-title">Little pixels.<br />Real momentum.</h2>
      <p class="muted">Your spinner floats above the desktop. Hold <kbd>Space</kbd> and move one finger to add momentum. Push again to speed up, move against the spin to brake, or let it coast.</p>
      <p class="muted"><kbd>Option</kbd> + <kbd>Space</kbd> brings it up.<br /><kbd>Escape</kbd> puts you back in control.</p>
      <a class="text-link" href={`${base}support/`}>First launch &amp; controls →</a>
    </div>
    <figure class="standard">
      <img src={`${base}standard.png`} alt="The included Standard spinner, with a dark body and silver bearings" width="192" height="148" loading="lazy" />
      <figcaption>STANDARD / INCLUDED FREE</figcaption>
    </figure>
  </section>

  <section class="section-block" aria-labelledby="skins-title">
    <div class="skins-heading">
      <div>
        <p class="eyebrow">02 / MAKE IT YOURS</p>
        <h2 id="skins-title"><span>1998</span><br />Translucent Pack.</h2>
      </div>
      <p class="muted">Four classic looks. Pure ’90s energy.<br />An optional one-time purchase, not a subscription. Preview every skin in the app before you unlock the pack.</p>
    </div>
    <div class="skins">
      {skins.map((skin) => <figure>
        <img src={`${base}${skin.file}`} alt={`${skin.name} translucent spinner skin`} width="192" height="148" loading="lazy" />
        <figcaption>{skin.name}</figcaption>
      </figure>)}
    </div>
    <figure class="app-preview">
      <figcaption>THE SKIN PICKER / IN THE APP</figcaption>
      <img src={`${base}skin-picker.png`} alt="Hand Spinner’s skin picker with four skins, a one-time unlock button and Restore Purchases" width="1440" height="900" loading="lazy" />
      <p class="muted">App preview. Availability and the final price are shown by Apple at purchase.</p>
    </figure>
  </section>

  <section class="closing">
    <div><p class="eyebrow">03 / NOTHING TO TRACK</p><h2>Just you.<br />And a spinner.</h2></div>
    <div><p class="muted">No account. No ads. No analytics. Trackpad input stays on your Mac.</p><a class="text-link" href={`${base}privacy/`}>Read the privacy policy →</a><br /><a class="text-link" href={`${base}support/`}>Need a hand? →</a></div>
  </section>
</HandSpinnerLayout>

<style>
  .hero { display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: clamp(2rem, 6vw, 6rem); padding-bottom: 5rem; }
  h1 span, h2 span { color: var(--accent); }
  .hero-lede { margin: 2rem 0 0; font-size: clamp(1.1rem, 2vw, 1.45rem); }
  .hero .muted { margin-top: .5rem; max-width: 33ch; }
  .hero-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 1.2rem; margin-top: 2rem; }
  .availability { font: .68rem var(--mono); color: #bbb9b4; line-height: 1.7; }
  .hero-visual img { display: block; width: 100%; height: auto; }
  .hero-visual p { margin: 1.5rem 0 0; color: var(--muted); text-align: center; font: .68rem var(--mono); }
  .hero-visual span { padding: 0 .6rem; color: var(--accent); }
  .play { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(2rem, 6vw, 6rem); border-top: 1px solid var(--line); }
  .play-copy > p:not(.eyebrow) { max-width: 44ch; }
  figure { margin: 0; }
  .standard { background: radial-gradient(ellipse at center, #28201a, transparent 70%); }
  .standard img { width: 100%; height: auto; display: block; image-rendering: pixelated; }
  figcaption { text-align: center; font: .68rem var(--mono); color: #ccc7c0; letter-spacing: .05em; }
  .skins-heading, .closing { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .skins-heading > p { max-width: 44ch; }
  .skins { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--line); margin-top: 2.5rem; border: 1px solid var(--line); }
  .skins figure { padding: 1rem .5rem 1.5rem; background: var(--surface); }
  .skins img { display: block; width: 100%; height: auto; image-rendering: pixelated; }
  .app-preview { margin-top: 3rem; border: 1px solid var(--line); }
  .app-preview figcaption { padding: 1.2rem; text-align: left; border-bottom: 1px solid var(--line); }
  .app-preview img { display: block; width: 100%; height: auto; }
  .app-preview > p { padding: 0 1.2rem; font-size: .8rem; }
  .closing { padding-top: clamp(4rem, 8vw, 7rem); }
  @media (max-width: 760px) {
    .hero, .play, .skins-heading, .closing { grid-template-columns: 1fr; }
    .hero-visual { width: min(100%, 380px); justify-self: center; }
    .hero { padding-bottom: 3rem; }
    .hero h1 { font-size: clamp(4rem, 19vw, 7rem); }
    .skins { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
