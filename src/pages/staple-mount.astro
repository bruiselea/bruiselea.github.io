---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import { mountFiles as files, shelfDefaults } from "../scripts/staple-mount-types";
---
<BaseLayout
  title="ホチキス壁掛けメーカー — Natsuki Sato"
  description="石膏ボード用のスライド式壁掛けを設計。寸法を入力するか自作STLを読み込み、ブラウザから印刷用データを書き出せます。"
  image={files + "starter-shelf.png"}
>
  <main class="mount-page">
    <header class="mount-intro">
      <p class="mount-release">公開アルファ</p>
      <h1>ホチキス壁掛けメーカー</h1>
      <p>ベースを石膏ボードに留め、棚やホルダーを上から差し込むと針が隠れます。寸法を合わせて、3Dプリント用の部品を作れます。</p>
    </header>

    <div class="mount-workspace">
      <form id="mount-form" class="mount-form">
        <label class="mount-field">
          <span>作る形</span>
          <select name="style">
            <option value="4" selected>棚</option>
            <option value="0">受け付きホルダー</option>
            <option value="1">平板</option>
            <option value="2">自作 STL を取り付ける</option>
            <option value="3">自由設計用ひな形</option>
          </select>
        </label>
        <div class="mount-pair">
          <label class="mount-field">
            <span>ベースサイズ</span>
            <select name="base">
              <option value="0">S · 針 6 本</option>
              <option value="1">M · 針 12 本</option>
              <option value="2">L · 針 20 本</option>
            </select>
          </label>
          <label class="mount-field">
            <span>片側のすき間</span>
            <div class="number-field"><input name="slide" type="number" min="0.15" max="0.35" step="0.05" value="0.25" required /><span>mm</span></div>
          </label>
        </div>

        <fieldset id="mount-outline" hidden disabled>
          <legend class="visually-hidden">カバーの外形</legend>
          <label class="mount-field">
            <span>カバーの外形</span>
            <select name="outline">
              <option value="0">長方形（標準）</option>
              <option value="1">角丸</option>
              <option value="2">台形</option>
              <option value="3">アーチ</option>
            </select>
          </label>
        </fieldset>

        <fieldset id="mount-outline-size" hidden disabled>
          <legend class="visually-hidden">外形の寸法</legend>
          <div class="mount-pair">
            <label class="mount-field">
              <span>カバーの幅</span>
              <div class="number-field"><input name="outlineWidth" type="number" min="74" max="250" step="0.1" value="104" required /><span>mm</span></div>
            </label>
            <label class="mount-field">
              <span>カバーの高さ</span>
              <div class="number-field"><input name="outlineHeight" type="number" min="46" max="250" step="0.1" value="78" required /><span>mm</span></div>
            </label>
          </div>
          <p id="outline-help" class="field-note"></p>
        </fieldset>

        <fieldset id="mount-shelf" class="mount-pair">
          <legend class="visually-hidden">棚板の寸法</legend>
          <label class="mount-field">
            <span>棚板の幅</span>
            <div class="number-field"><input name="shelfWidth" type="number" min="73" max="250" step="0.1" value={shelfDefaults.width} required /><span>mm</span></div>
          </label>
          <label class="mount-field">
            <span>棚板の奥行き</span>
            <div class="number-field"><input name="shelfDepth" type="number" min="20" max="120" step="0.1" value={shelfDefaults.depth} required /><span>mm</span></div>
          </label>
        </fieldset>

        <fieldset id="mount-dimensions" class="mount-pair" hidden disabled>
          <legend class="visually-hidden">本体の寸法</legend>
          <label class="mount-field">
            <span id="mount-width-label">機器の幅</span>
            <div class="number-field"><input name="width" type="number" min="10" max="250" step="0.1" value="60" required /><span>mm</span></div>
          </label>
          <label class="mount-field">
            <span id="mount-height-label">背板の高さ</span>
            <div class="number-field"><input name="height" type="number" min="20" max="250" step="0.1" value="80" required /><span>mm</span></div>
          </label>
        </fieldset>

        <fieldset id="mount-holder" class="mount-holder" hidden disabled>
          <legend class="visually-hidden">受け付きホルダー</legend>
          <div class="mount-pair">
            <label class="mount-field">
              <span>機器の厚み</span>
              <div class="number-field"><input name="depth" type="number" min="2" max="65" step="0.1" value="18" required /><span>mm</span></div>
            </label>
            <label class="mount-field">
              <span>前縁の高さ</span>
              <div class="number-field"><input name="lip" type="number" min="4" max="16" step="0.1" value="6" required /><span>mm</span></div>
            </label>
          </div>
          <label class="mount-field">
            <span>受けのすき間</span>
            <div class="number-field"><input name="fit" type="number" min="0.2" max="2" step="0.1" value="0.5" required /><span>mm</span></div>
          </label>
        </fieldset>

        <fieldset id="mount-import" hidden disabled>
          <legend class="visually-hidden">自作 STL</legend>
          <label class="mount-field">
            <span>自作 STL</span>
            <input type="file" name="stl" accept=".stl,model/stl,application/sla" required aria-describedby="stl-help" />
          </label>
          <p class="field-note" id="stl-help">接合面を −Z、取り付け時の上を +Y にした閉じた STL を選びます。ファイルはブラウザ内で処理します。</p>
          <div class="mount-pair">
            <label class="mount-field">
              <span>左右のずらし量</span>
              <div class="number-field"><input name="offsetX" type="number" min="-250" max="250" step="0.1" value="0" required /><span>mm</span></div>
            </label>
            <label class="mount-field">
              <span>上下のずらし量</span>
              <div class="number-field"><input name="offsetY" type="number" min="-250" max="250" step="0.1" value="0" required /><span>mm</span></div>
            </label>
          </div>
        </fieldset>

        <p id="mount-cad-help" class="field-note" hidden>正面が Z=0 のカバーを生成します。すぐにCADで編集できるSTEPはページ下にあります。</p>
        <button type="submit" class="mount-generate">3Dモデルを生成</button>
      </form>

      <section class="mount-output" aria-labelledby="mount-preview-title">
        <div class="preview-header">
          <h2 id="mount-preview-title">3Dプレビュー</h2>
          <div class="preview-views" aria-label="プレビューの表示">
            <button type="button" data-view="exploded" aria-pressed="true">差し込み前</button>
            <button type="button" data-view="installed" aria-pressed="false">装着</button>
            <button type="button" data-view="print" aria-pressed="false">印刷配置</button>
          </div>
        </div>
        <div class="mount-stage" id="mount-stage">
          <img class="preview-fallback" src={files + "starter-shelf.png"} alt="棚を壁側ベースに差し込む前の形状" width="1200" height="630" />
        </div>
        <div class="preview-footer">
          <div class="mount-legend">
            <span><i class="base-swatch"></i> 壁側ベース</span>
            <span><i class="cover-swatch"></i> カバー</span>
          </div>
          <span id="mount-dimensions-readout"></span>
        </div>
        <div class="mount-downloads">
          <button id="mount-download-base" type="button" disabled>ベース STL</button>
          <button id="mount-download-cover" type="button" disabled>棚 STL</button>
        </div>
        <p id="mount-status" class="mount-status" role="status" aria-live="polite">サンプルを読み込んでいます。</p>
        <noscript>ブラウザのJavaScriptを有効にすると寸法を変更できます。</noscript>
      </section>
    </div>

    <div class="mount-notes">
      <section>
        <h2>CAD で自由に設計</h2>
        <p>壁側ベースと同じサイズのSTEPを開き、正面（Z=0）にフックや棚受けを作って結合します。取り付け時の上は +Y、手前は +Z です。あり溝のすき間は片側0.25 mmです。</p>
        <div class="mount-links">
          {["S", "M", "L"].map((size) => (
            <a href={files + "Slide-Mount-CAD-Template-" + size + ".step"} download>{size} の STEP</a>
          ))}
        </div>
      </section>
      <section>
        <h2>取り付け方</h2>
        <ol>
          <li>溝の開口を上にして、ベースを石膏ボードに当てます。</li>
          <li>180°開くホチキスで、10号針を窓に横向きに打ちます。針の両足を同じ窓の薄膜に通します。</li>
          <li>カバーを上から差し込みます。外すときは載せた物を下ろし、真上に持ち上げます。</li>
        </ol>
        <p>耐荷重は未測定です。設置先と同じ下地で、打ち込みと取り付けを試してください。</p>
      </section>
    </div>
    <p class="mount-source"><a href={files + "Staple-Wall-Mount-Maker.scad"} download>OpenSCAD ソース</a><span> · </span><a href="https://github.com/lofcz/openscad-wasm">OpenSCAD WebAssembly</a><span> · </span><a href={files + "OpenSCAD-COPYING.txt"}>ライセンス</a></p>
  </main>
  <Footer />
</BaseLayout>

<script>
  import "../scripts/staple-mount";
</script>

<style>
  .mount-page { max-width: 1450px; margin-inline: auto; padding: clamp(2rem, 5vw, 4.5rem) var(--page-pad) 3.5rem; }
  .mount-intro { margin-bottom: clamp(1.8rem, 4vw, 3rem); }
  .mount-intro .mount-release { margin: 0 0 .55rem; color: var(--accent); font-size: .875rem; font-weight: 620; }
  .mount-intro h1 { margin: 0; font-size: clamp(1.9rem, 4.1vw, 3.6rem); font-weight: 590; letter-spacing: -.05em; line-height: 1.18; }
  .mount-intro p { color: #b5b5be; max-width: 62ch; margin: .95rem 0 0; line-height: 1.8; }
  .mount-workspace { display: grid; grid-template-columns: minmax(290px, 320px) minmax(0, 1fr); gap: 1rem; align-items: start; }
  .mount-form, .mount-output { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .mount-form { display: grid; gap: 1rem; padding: 1.25rem; }
  fieldset { margin: 0; padding: 0; border: 0; min-width: 0; }
  [hidden] { display: none !important; }
  .mount-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  .mount-holder { display: grid; gap: 1rem; }
  .mount-field { display: grid; min-width: 0; gap: .42rem; font-size: .875rem; font-weight: 590; color: #dedede; }
  .mount-field select, .mount-field input {
    width: 100%; min-width: 0; height: 2.72rem; padding: .45rem .65rem; border: 1px solid var(--line-strong);
    border-radius: 7px; color: var(--ink); background: var(--surface-raised); font: inherit;
  }
  .mount-field select {
    appearance: none; text-overflow: ellipsis; padding-right: 1.95rem;
    background-image: linear-gradient(45deg, transparent 50%, #b5b5be 50%), linear-gradient(135deg, #b5b5be 50%, transparent 50%);
    background-position: right 15px center, right 10px center; background-size: 5px 5px; background-repeat: no-repeat;
  }
  .mount-field input[type="file"] { height: auto; padding: .55rem; font-weight: 400; }
  .number-field { position: relative; }
  .number-field input { padding-right: 2.25rem; appearance: textfield; }
  .number-field input::-webkit-inner-spin-button { appearance: none; }
  .number-field span { position: absolute; top: .77rem; right: .65rem; color: var(--muted); pointer-events: none; }
  .field-note { font-size: .875rem; line-height: 1.65; color: #b5b5be; margin: .45rem 0 .75rem; }
  .mount-form button, .mount-output button, .mount-links a {
    min-height: 2.6rem; border: 1px solid var(--line-strong); border-radius: 7px; padding: .45rem .75rem;
    color: var(--ink); background: var(--surface-raised); font-size: .875rem; font-weight: 590;
  }
  button:not(:disabled) { cursor: pointer; }
  .mount-generate { border-color: var(--accent) !important; background: var(--accent) !important; color: #150900 !important; }
  button:disabled { opacity: .48; cursor: default; }
  .preview-header, .preview-footer {
    display: flex; align-items: center; justify-content: space-between; gap: .65rem 1rem; flex-wrap: wrap; padding: .75rem 1rem;
  }
  .preview-header h2 { margin: 0; font-size: 1rem; font-weight: 650; }
  .preview-views { display: flex; gap: .35rem; flex-wrap: wrap; }
  .preview-views button { min-height: 2.18rem; padding: .3rem .55rem; }
  .preview-views button[aria-pressed="true"] { color: #ffc5af; border-color: #b6593c; background: #301912; }
  .mount-stage {
    position: relative; display: grid; place-items: center; height: clamp(310px, 54vw, 540px);
    background: #141619; border-block: 1px solid var(--line);
  }
  .mount-stage :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }
  .preview-fallback { width: min(88%, 630px); height: auto; opacity: .87; border-radius: 8px; }
  .preview-footer { justify-content: space-between; color: #c3c4ce; font-size: .875rem; }
  .mount-legend, .mount-downloads, .mount-links { display: flex; flex-wrap: wrap; gap: .5rem 1rem; }
  .mount-legend i { display: inline-block; width: .68rem; height: .68rem; margin-right: .2rem; border-radius: 50%; }
  .base-swatch { background: #73adb7; }
  .cover-swatch { background: #f4a266; }
  .mount-downloads { padding: .1rem 1rem .2rem; gap: .5rem; }
  .mount-downloads button:not(:disabled):hover, .mount-links a:hover { border-color: var(--accent); }
  .mount-status { margin: 0; padding: .55rem 1rem .85rem; min-height: 2.9rem; color: #c1c0c9; font-size: .875rem; }
  .mount-status[data-error="true"] { color: #ffad96; }
  .mount-notes { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 2.25rem; margin-top: 2.6rem; }
  .mount-notes section { border-top: 1px solid var(--line); padding-top: 1.1rem; }
  .mount-notes h2 { font-size: 1.22rem; margin: 0 0 .8rem; }
  .mount-notes p, .mount-notes ol { margin-block: .65rem 1rem; color: #b5b5be; line-height: 1.7; }
  .mount-notes ol { padding-left: 1.35rem; }
  .mount-notes li { padding-bottom: .32rem; }
  .mount-links { gap: .45rem; }
  .mount-links a { display: inline-flex; align-items: center; text-decoration: none; }
  .mount-source { margin-top: 1.8rem; color: #babac3; font-size: .875rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (max-width: 820px) {
    .mount-workspace, .mount-notes { grid-template-columns: minmax(0, 1fr); }
    .mount-stage { height: clamp(285px, 68vw, 445px); }
    .preview-views button { min-height: 2.6rem; }
  }
</style>
