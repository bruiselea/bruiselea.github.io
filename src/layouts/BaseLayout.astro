---
import "../styles/global.css";
import Header from "../components/Header.astro";

interface Props {
  title?: string;
  description?: string;
  studio?: boolean;
  hideHeader?: boolean;
  image?: string;
  lang?: "ja" | "en";
}

const {
  title = "Natsuki Sato — Material Orbit",
  description = "材料工学、3Dプリンティング、電子工作、ソフトウェアを横断する佐藤夏樹のポートフォリオ。",
  studio = false,
  hideHeader = false,
  image,
  lang = "ja",
} = Astro.props;
---

<!doctype html>
<html lang={lang} class:list={{ "is-studio": studio }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050506" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "ja_JP"} />
    {image && <meta property="og:image" content={new URL(image, "https://nuunnu.com").href} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={new URL(image, "https://nuunnu.com").href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="preload"
      href="/fonts/GoogleSansFlex.ttf"
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />
    <title>{title}</title>
  </head>
  <body class:list={{ "studio-body": studio }}>
    {!hideHeader && <Header studio={studio} />}
    <slot />
  </body>
</html>
