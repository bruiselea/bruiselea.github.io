---
import type { Work } from "../data/works";

interface Props {
  work: Work;
  eager?: boolean;
  fullBleed?: boolean;
}

const { work, eager = false, fullBleed = false } = Astro.props;
---

<figure
  class:list={["work-visual", {
    "work-visual--low-res": work.asset.lowRes,
    "work-visual--full-bleed": fullBleed,
  }]}
  style={`--work-accent:${work.accent}`}
>
  <img
    src={work.asset.src}
    alt={work.asset.alt ?? `${work.title}のイメージレンダー`}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  />
  <figcaption>
    {work.asset.caption ?? `RENDER — ${work.titleEn.toUpperCase()}`}
  </figcaption>
</figure>
