---
import type { Work } from "../data/works";

interface Props {
  work: Work;
  eager?: boolean;
}

const { work, eager = false } = Astro.props;
---

<figure class="work-visual" style={`--work-accent:${work.accent}`}>
  <img
    src={work.asset.src}
    alt={work.asset.alt ?? `${work.title}の仮3Dレンダー`}
    loading={eager ? "eager" : "lazy"}
    decoding={eager ? "sync" : "async"}
    fetchpriority={eager ? "high" : "auto"}
    width="800"
    height="600"
  />
  <figcaption>
    {work.asset.caption ?? "仮レンダー — 最終版では自作モデル／実物レンダーへ差し替え予定"}
  </figcaption>
</figure>
